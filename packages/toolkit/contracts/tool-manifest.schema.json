{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sie.example/contracts/tool-manifest-v1.schema.json",
  "title": "Signed Superintelligence domain-tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "publisherKeyId",
    "domain",
    "minEngineVersion",
    "operations",
    "uiAnchors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}(\\.[a-z][a-z0-9-]{1,31})+$"
    },
    "publisherKeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "domain": {
      "enum": [
        "code",
        "music",
        "poetry",
        "persuasive-writing",
        "research",
        "legislation",
        "image",
        "video",
        "voice",
        "data",
        "workflow"
      ]
    },
    "minEngineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "uiAnchors": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "handler",
          "inputSchema",
          "outputSchema",
          "requiredScopes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "handler": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "requiredScopes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            }
          }
        }
      }
    }
  }
}
